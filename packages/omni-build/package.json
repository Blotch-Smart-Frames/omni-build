{
  "name": "@blotch/omni-build",
  "version": "0.0.0",
  "description": "Build, sign, install and ship iOS and Android apps with no native toolchain: no Xcode, no JDK, no Android SDK",
  "keywords": [
    "aab",
    "android",
    "apk",
    "codesign",
    "ios",
    "ipa",
    "lynx"
  ],
  "homepage": "https://github.com/Blotch-Smart-Frames/omni-build#readme",
  "bugs": {
    "url": "https://github.com/Blotch-Smart-Frames/omni-build/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blotch-Smart-Frames/omni-build.git",
    "directory": "packages/omni-build"
  },
  "bin": {
    "omni-build": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "cspell": "cspell --no-progress .",
    "typecheck": "tsc"
  },
  "engines": {
    "node": ">=22.12"
  }
}
