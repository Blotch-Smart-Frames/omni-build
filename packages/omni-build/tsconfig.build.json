{
  // The launcher as npm ships it: plain JavaScript in dist/, because Node
  // won't run TypeScript from node_modules.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    // Types for the API build tools import (src/index.ts).
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
