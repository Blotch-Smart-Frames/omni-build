{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": ["dist/**"]
    },
    // The tests run the compiled launcher against the binary Cargo builds,
    // so both builds have to come first. The Rust crate isn't an npm
    // dependency of this package (it's never published to npm), so `^build`
    // wouldn't order it.
    "test": {
      "dependsOn": ["build", "@omni-build/cli#build"]
    },
    "test:coverage": {
      "dependsOn": ["build", "@omni-build/cli#build"],
      "outputs": ["coverage/**"]
    }
  }
}
