{
  "$schema": "../../node_modules/@cspell/cspell-types/cspell.schema.json",
  "version": "0.2",
  "import": ["../../cspell.json"],
  // The Gradle wrappers and the Xcode projects, as Gradle and Xcode generate
  // them.
  "ignorePaths": [
    "*/android/gradlew",
    "*/android/gradlew.bat",
    "*/android/gradle/wrapper",
    "*/ios/*.xcodeproj"
  ],
  "words": [
    "aars",
    "allprojects",
    "androidplatform",
    "appassets",
    "Dfile",
    "Inspectable",
    "jvmargs",
    "mkdirs",
    "Pomni",
    "println",
    "unhandledrejection",
    "WKUI",
    "WKURL",
    "xcodeproj",
    "xcuserdata"
  ]
}
