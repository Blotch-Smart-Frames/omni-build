<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Most web apps talk to a server. The payload itself is served from the
         APK, which needs no network. An app that needs none drops it with
         android.permissions. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- enableOnBackInvokedCallback: from Android 13, the back gesture goes
         back in the page's history through OnBackInvokedCallback, and the
         system's predictive back animation runs when there's none left. -->
    <application
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WebViewShell">
        <!-- The page lays itself out again when the screen turns, the keyboard
             comes and goes or the theme changes, as in a browser, rather than
             the activity starting over and reloading it. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="density|keyboard|keyboardHidden|layoutDirection|locale|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The runtime the shell registers native modules of, which a
             module has to be built for: OmniBuild refuses one built for
             another, and adds the rest to the app's code, listing them in
             dev.omnibuild.modules for NativeModules to make. -->
        <meta-data
            android:name="dev.omnibuild.runtime"
            android:value="webview@1" />
    </application>

</manifest>
