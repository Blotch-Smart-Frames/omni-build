{
  "id": "dev.omnibuild.e2e.app",
  "name": "OmniBuild E2E",
  "version": "2.5.0",
  "build": 42,
  "icon": "icon.png",
  "payload": "payload",
  "urlSchemes": ["omnibuild-e2e"],
  "orientation": "landscape",
  "android": {
    "permissions": ["INTERNET", "VIBRATE"],
    "abis": ["x86_64", "arm64-v8a"]
  },
  "ios": {
    "usageDescriptions": {
      "NSCameraUsageDescription": "Scans the codes on OmniBuild's test cards."
    },
    "entitlements": {
      "aps-environment": "development",
      "com.apple.developer.associated-domains": [
        "applinks:e2e.omnibuild.example"
      ],
      "com.apple.security.application-groups": ["group.dev.omnibuild.e2e"],
      "keychain-access-groups": [
        "$(AppIdentifierPrefix)dev.omnibuild.e2e.shared"
      ]
    },
    "bundles": {
      "ShellNotifications": {
        "entitlements": {
          "com.apple.security.application-groups": ["group.dev.omnibuild.e2e"]
        }
      }
    }
  }
}
