{
  "name": "@blotch/omni-build-e2e",
  "version": "0.0.1",
  "private": true,
  "description": "End-to-end tests: real Swift and Kotlin app shells, built with Xcode and Gradle, run on the iOS Simulator and an Android emulator",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "e2e": "node src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "cspell": "cspell --no-progress .",
    "typecheck": "tsc"
  },
  "engines": {
    "node": ">=22.18"
  }
}
