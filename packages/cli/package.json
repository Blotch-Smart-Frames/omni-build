{
  "name": "@blotch/omni-build-cli",
  "version": "0.0.1",
  "private": true,
  "description": "The omni binary, in Rust. This package.json only lets turbo run Cargo alongside the npm packages",
  "license": "MIT",
  "scripts": {
    "build": "cargo build --release --locked",
    "test": "cargo test --locked",
    "test:coverage": "cargo llvm-cov --locked --fail-under-lines 100 --fail-under-functions 100 --fail-under-regions 100",
    "lint": "cargo clippy --all-targets --locked -- -D warnings",
    "lint:fix": "cargo clippy --all-targets --fix --allow-dirty --allow-staged",
    "cspell": "cspell --no-progress .",
    "format": "cargo fmt",
    "format:check": "cargo fmt --check"
  }
}
