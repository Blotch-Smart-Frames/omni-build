{
  "name": "@blotch/omni-build-release",
  "version": "0.0.0",
  "private": true,
  "description": "Packs OmniBuild's npm packages, the launcher and one per platform, and checks that npm installs the right binary from them",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "release": "node src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "cspell": "cspell --no-progress .",
    "typecheck": "tsc"
  },
  "engines": {
    "node": ">=22.18"
  }
}
