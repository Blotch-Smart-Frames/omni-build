{
  "name": "@blotch/omni-build-platform-watch",
  "version": "0.0.1",
  "private": true,
  "description": "Opens an issue when Apple or Google raise their store minimums or release an SDK the app shells aren't built with",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "node src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "cspell": "cspell --no-progress .",
    "typecheck": "tsc"
  },
  "engines": {
    "node": ">=22.18"
  }
}
