{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": true,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSpacing": true,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.claude/**",
    "**/.agents/**",
    "target/**",
    "**/dist/**",
    "packages/e2e/fixtures/**",
    "packages/shells/*/android/**",
    "packages/shells/*/ios/**",
    "packages/docs/build/**",
    "packages/docs/.docusaurus/**",
    "**/.impeccable/**"
  ]
}
